{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Culm",
  "version": "0.1.0",
  "identifier": "garden.culm.library",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Culm",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "seed/": "seed/",
      "native/": "native/"
    }
  }
}
